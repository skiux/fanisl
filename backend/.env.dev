# 本地开发的隔离配置。用法：
#     cd backend && FANISL_ENV_FILE=.env.dev PYTHONPATH=src \
#       .venv/bin/uvicorn analyzer.main:app --port 8000
#
# 里面没有任何机密，可以进 git——它的作用是让"隔离开发"成为一条现成的路，
# 而不是每次靠记住覆盖什么。三个库用 tools/dev_db.sh 建。
PG_CONNINFO=dbname=fanisl_dev
PG_TRADING_CONNINFO=dbname=fanisl_dev_trading
PG_KNOWLEDGE_CONNINFO=dbname=fanisl_dev_knowledge
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=false

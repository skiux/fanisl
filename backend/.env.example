# 复制为 .env 并填入真实值
ANTHROPIC_API_KEY=sk-

# 第三方中转（如 aipro.love）：填基址，不带 /v1。官方留空。
# ANTHROPIC_BASE_URL=https://vip.aipro.love
# 走中转时模型设为中转支持的（如 claude-opus-4-7）；官方默认 claude-opus-4-8
# MODEL=claude-opus-4-7

# 多资产数据源（按需填）
# POLYGON_API_KEY=...        # 美股/指数/ETF/原油（NVDA/NDX/QQQ/CL 等）
# OANDA_API_TOKEN=...        # 金属 XAU/XAG
# OANDA_PRACTICE=true        # demo/practice 账户用 true
# COINALYZE_API_KEY=...      # 加密爆仓数据（聚合多所；coinalyze.net 免费注册）
#                            # 不填则期权/基差/大户多空比照常，仅缺爆仓那块
#                            # 期权(Deribit)无需任何 key，自动启用

# 事件与催化剂（Part 2）。代币解锁(DefiLlama)无需 key、已自动启用；以下填了才启用对应维度：
# FRED_API_KEY=...           # 宏观日历 CPI/PPI/就业/GDP（fred.stlouisfed.org 免费；FOMC 排除见 docs）
# CRYPTOCOMPARE_API_KEY=...  # 新闻标题（developers.coindesk.com，原 CryptoCompare，免费）
# COINMARKETCAL_API_KEY=...  # 币圈事件：⚠️ API 已转付费，免费注册也用不了；当前由新闻+解锁部分覆盖
#                            # ETF 资金流暂无免费源，见 doc/data-upgrades.md

# 情绪与注意力（Part 3）。恐惧贪婪指数(Alternative.me)无需 key、已自动启用。
# LUNARCRUSH_API_KEY=...     # 社交热度：⚠️ LunarCrush API 2026 起转付费，免费 key 全端点 402，
#                            #   故暂不挂；订阅 Individual+ 或换 Santiment 再启用。
# 链上数据（Part 4）全部无需 key、已自动启用：DefiLlama 稳定币/链TVL + Blockchain.info BTC 网络。

# 可选覆盖（都有默认值）
# EXCHANGE=okx
# DEFAULT_SYMBOL=BTC/USDT
# DB_PATH=fanisl.db


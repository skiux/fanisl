[Unit]
Description=fanisl trader (自主交易调度：快盯市 + 慢 Claude 决策，两条线程)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=fanisl
Group=fanisl
WorkingDirectory=/opt/fanisl/backend
# 单实例：PG advisory lock 防呆，跑两份第二个会自行退出。切勿配多份。
ExecStart=/opt/fanisl/backend/.venv/bin/python -m analyzer.worker_trader
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

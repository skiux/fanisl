# fanisl 后端配置（复制到 backend/.env）。pydantic-settings 自动读取。
# 真实 key 只放这里，切勿提交进 git（.env 已在 .gitignore）。

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# 官方留空；第三方中转填基址(不带 /v1)
ANTHROPIC_BASE_URL=
MODEL=claude-opus-4-8

# --- 交易所（默认 binance，数据最全）---
EXCHANGE=binance

# --- 数据库（PostgreSQL + TimescaleDB）---
# **必须写 host=127.0.0.1**：Postgres 跑在 Docker 里，宿主机上没有 Unix socket，
# 不写 host 会去连 /var/run/postgresql/.s.PGSQL.5432 并报 "No such file or directory"。
# <口令> 换成 docker run 时设的 POSTGRES_PASSWORD。
PG_CONNINFO=host=127.0.0.1 dbname=fanisl user=fanisl password=<口令>
PG_TRADING_CONNINFO=host=127.0.0.1 dbname=fanisl_trading user=fanisl password=<口令>
PG_KNOWLEDGE_CONNINFO=host=127.0.0.1 dbname=fanisl_knowledge user=fanisl password=<口令>
# 三条都要改。少改一条的表现是：某个池连不上而另两个正常，而报错里看不出是哪个库。
# 若 Postgres 装在宿主机（非 Docker）且用 peer 认证，才可以省掉 host 与 password。

# --- 数据源 key（按需填，缺则对应维度为空）---
POLYGON_API_KEY=          # 美股/指数/ETF/原油分析
OANDA_API_TOKEN=          # 金属(金银)分析
OANDA_PRACTICE=true
COINALYZE_API_KEY=        # 爆仓聚合
FRED_API_KEY=             # 宏观日历
CRYPTOCOMPARE_API_KEY=    # 新闻
NEWSAPI_API_KEY=
FINNHUB_API_KEY=
BENZINGA_API_KEY=

# --- 采集 / 交易开关（默认即可，列出便于按需调）---
COLLECTOR_ENABLED=true
TRADING_ENABLED=true
TRADING_SCAN_ENABLED=true
TRADING_INITIAL_BALANCE=10000
# TRADING_MAX_POSITIONS=3
# TRADING_MAX_TOTAL_RISK_PCT=5
# TRADING_SCAN_INTERVAL_S=14400

# --- 知识引擎（L0 转录 / L1 提取 / L2 评分）---
# 转录走 Gemini。二选一：
#   1) AI Studio key（GEMINI_API_KEY）
#   2) Vertex / Agent Platform：填 GCP_PROJECT 后走这条，不再读 key。服务器上优先用它。
#      GCP_PROJECT 填**项目 ID**（小写串，如 murgrottos），不是显示名称。
#      取 token 顺序：先看 ~/.config/gcloud/application_default_credentials.json（开发机上由
#      gcloud auth application-default login 生成），没有该文件才走 GCE 元数据服务器
#      （实例服务账号签发，盘上零凭据）。所以服务器上**不要放**那个文件。
#      实例需绑服务账号、授 roles/aiplatform.user、且 scope 含 cloud-platform。
GEMINI_API_KEY=
GCP_PROJECT=
# 钉死模型，别用 *-latest 别名（换代过两次都直接打断摄取链）
GEMINI_MODEL=gemini-3.5-flash

# yt-dlp 的 YouTube cookies（频道清单/元数据/提帧在被 bot 验证拦时才需要）。
# 路径相对 backend/。内含真实 Google 会话，等同凭据——按需下发，不进 git。
YOUTUBE_COOKIES_FILE=

# 关键帧图片目录。默认按源码位置推 data_export/keyframes；
# 与源码不同处（worktree / 独立数据盘）必须显式指定，否则读图 404、清理只删库不删文件。
KEYFRAME_ROOT=

# 知识引擎两个后台 job 的间隔（collector 宿主）
KNOWLEDGE_DAILY_INTERVAL_S=86400
KNOWLEDGE_WEEKLY_INTERVAL_S=604800

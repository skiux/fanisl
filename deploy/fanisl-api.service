[Unit]
Description=fanisl API + 后台采集/交易调度 (FastAPI/uvicorn)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=fanisl
Group=fanisl
WorkingDirectory=/opt/fanisl/backend
# .env 在 WorkingDirectory 下，pydantic-settings 自动读取
# 关键：单 worker。采集器/交易调度是 app 启动起的后台线程，多 worker 会重复采集+重复自主交易。
ExecStart=/opt/fanisl/backend/.venv/bin/uvicorn analyzer.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
# 优雅停机：让调度器 shutdown 钩子停掉后台线程
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

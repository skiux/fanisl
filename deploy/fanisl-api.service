[Unit]
Description=fanisl API (FastAPI/uvicorn，仅请求服务，不起后台调度)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=fanisl
Group=fanisl
WorkingDirectory=/opt/fanisl/backend
# .env 在 WorkingDirectory 下，pydantic-settings 自动读取
# 服务拆分后 API 不再起采集/交易调度（那些在 fanisl-collector / fanisl-trader）。
# 因此这里可以安全地用多 worker 扩并发（如 --workers 2/4）；后台单实例的约束在 worker 单元里。
ExecStart=/opt/fanisl/backend/.venv/bin/uvicorn analyzer.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

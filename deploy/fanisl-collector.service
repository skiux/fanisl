[Unit]
Description=fanisl collector (采集调度：market/catalysts + 知识引擎 daily/weekly)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=fanisl
Group=fanisl
WorkingDirectory=/opt/fanisl/backend
# 让 git 树成为运行中的代码。少了这行，服务会解析到 pip install 拷进 site-packages 的
# 那份快照，于是 git pull + restart 变成空操作，而且毫无迹象——2026-08-21 排查发现
# 服务器自部署起一直跑着安装当天的旧代码。装成可编辑（pip install -e .）也能达到同样
# 效果，两者同时做是有意的冗余：任一处被改回去，另一处仍然兜得住。
Environment=PYTHONPATH=/opt/fanisl/backend/src
# 单实例：PG advisory lock 防呆，跑两份第二个会自行退出。切勿配多份。
ExecStart=/opt/fanisl/backend/.venv/bin/python -m analyzer.worker_collector
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
